# Copy this file to .env and fill in your values.
# Every value here is optional and can also be passed as a CLI flag
# (a CLI flag always overrides the matching env var).

# Athena database and table (default: analytics.batteries_v3)
ATHENA_DATABASE=analytics
ATHENA_TABLE=batteries_v3

# Athena workgroup (default: data_consumers)
ATHENA_WORKGROUP=data_consumers

# Named AWS CLI profile to use, e.g. from `aws configure sso`
AWS_PROFILE=infra_dev

# S3 URI for Athena query results. Leave blank if your workgroup already
# has a default query-result location configured in the Athena console.
ATHENA_S3_OUTPUT=data_consumers

# AWS region. Leave blank to use whatever your profile/AWS config already
# specifies (recommended, avoids region/credential mismatches).
AWS_REGION=eu-west-1


# ── AWS Athena configuration ────────────────────────────────────────────────────
# Used by: soc-estimate-athena CLI and AthenaDataSource
# All values can also be passed as CLI flags (--aws_profile, --workgroup, etc.)
# CLI flags always take precedence over environment variables.

# AWS named profile (from ~/.aws/credentials). Leave blank to use the default
# profile or instance role (e.g. on EC2/Lambda).
#AWS_PROFILE=infra_dev

# AWS region where your Athena workgroup lives.
#AWS_REGION=eu-west-1

# Athena database and table that hold your battery telemetry.
#ATHENA_DATABASE=analytics
#ATHENA_TABLE=batteries_v3

# Athena workgroup. The workgroup must have a default S3 output location
# configured so that ATHENA_S3_OUTPUT below can be left blank.
#ATHENA_WORKGROUP=data_consumers

# Optional: explicit S3 path for query results. Leave blank to use the
# workgroup's default output location.
# ATHENA_S3_OUTPUT=s3://balancell-20230322140353836900000001/consumer_query_outputs/


ODOO_URL=https://xamissa-balancell1.odoo.com
ODOO_DB=xamissa-balancell1-main-3329852
ODOO_USERNAME=lindokuhle.ngcongo@balancell.co
ODOO_API_KEY=dc40668bc142d3df75bfa8e050be4f6f0d6e2786

# Athena SOC lookup timeout (seconds). batteries_v3 can take 100s-30min+.
ATHENA_QUERY_TIMEOUT_SEC=1800
