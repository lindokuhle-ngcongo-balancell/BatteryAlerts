# Copy this file to .env and fill in the values needed for your workflow.
# BatteryAlerts.py uses Snowflake settings below. Athena settings are kept
# for the optional/archived Athena reporting scripts.

# ── Optional Athena settings (archived tools) ──────────────────────────────────
# Athena database and table (default: analytics.batteries_v3)
ATHENA_DATABASE=your_athena_database
ATHENA_TABLE=your_athena_table

# Athena workgroup (default: data_consumers)
ATHENA_WORKGROUP=data_consumers

# Named AWS CLI profile to use, e.g. from `aws configure sso`
AWS_PROFILE=your_aws_profile

# S3 URI for Athena query results. Leave blank if your workgroup already
# has a default query-result location configured in the Athena console.
ATHENA_S3_OUTPUT=your_s3_output_path

# AWS region. Leave blank to use whatever your profile/AWS config already
# specifies (recommended, avoids region/credential mismatches).
AWS_REGION=your_aws_region


# ── AWS Athena configuration ────────────────────────────────────────────────────
# Optional AWS credentials/configuration for archived Athena tools.

# AWS named profile (from ~/.aws/credentials). Leave blank to use the default
# profile or instance role (e.g. on EC2/Lambda).
#AWS_PROFILE=infra_dev

# AWS region where your Athena workgroup lives.
#AWS_REGION=eu-west-1

# Athena database and table that hold your battery telemetry.
#ATHENA_DATABASE=analytics
#ATHENA_TABLE=batteries_v3

# Athena workgroup. The workgroup must have a default S3 output location
# configured so that ATHENA_S3_OUTPUT below can be left blank.
#ATHENA_WORKGROUP=data_consumers

# Optional: explicit S3 path for query results. Leave blank to use the
# workgroup's default output location.
# ATHENA_S3_OUTPUT=s3://balancell-20230322140353836900000001/consumer_query_outputs/


ODOO_URL=your_odoo_url
ODOO_DB=your_odoo_db
ODOO_USERNAME=your_odoo_username
ODOO_API_KEY=your_odoo_api_key

# ── Snowflake configuration ─────────────────────────────────────────────────────
# Used by: BatteryAlerts.py SoC lookups and SnowflakeDataSource
# Install runtime support with: pip install snowflake-connector-python python-dotenv
# BatteryAlerts.py reads BALANCELL_DATA_PRODUCTION.TELEMETRY.TELEMETRY_MODULE.
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_WAREHOUSE=your_snowflake_warehouse
SNOWFLAKE_ROLE=your_snowflake_role
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_DATABASE=BALANCELL_DATA_PRODUCTION
SNOWFLAKE_SCHEMA=TELEMETRY

# Optional SoC lookup windows, in hours.
SOC_LOOKBACK_HOURS=24
SOC_AT_START_WINDOW_HOURS=2